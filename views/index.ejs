<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Welcome' }) %>
</head>
<body class="bg-[var(--bg)] text-[var(--text)] min-h-screen">

  <!-- Nav -->
  <nav class="navbar" style="position:static; background:transparent; backdrop-filter:none; border:none;">
    <div class="navbar-inner" style="max-width:1080px;">
      <a href="/" class="brand-link">
        <span class="brand-mark">◎</span> Loop
      </a>
      <div class="flex items-center gap-3">
        <a href="/login" class="btn-ghost">Log in</a>
        <a href="/register" class="btn-ghost" style="background:linear-gradient(135deg, var(--accent), #7c3aed); border:none; color:white;">Get started</a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative max-w-3xl mx-auto px-6 pt-20 pb-16 text-center">
    <div class="hero-glow"></div>
    <div class="relative">
      <span class="pill">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M13 2 3 14h7l-1 8 10-12h-7l1-8z"/></svg>
        A small, fast social feed
      </span>
      <h1 class="mt-6 text-5xl sm:text-6xl font-extrabold tracking-tight leading-[1.05]">
        Share your thoughts.<br>
        <span class="brand-gradient">One loop at a time.</span>
      </h1>
      <p class="mt-6 text-[var(--text-muted)] text-lg max-w-xl mx-auto">
        Loop is a minimal space to post updates, like what matters, and keep a running feed of everything on your mind — no noise, no clutter.
      </p>
      <div class="mt-9 flex items-center justify-center gap-4">
        <a href="/register" class="px-7 py-3 rounded-lg font-semibold text-white" style="background:linear-gradient(135deg, var(--accent), #7c3aed); box-shadow:0 8px 24px -8px rgba(99,102,241,0.5);">
          Create your account
        </a>
        <a href="/login" class="btn-ghost px-7 py-3">I already have one</a>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="max-w-4xl mx-auto px-6 pb-24 grid sm:grid-cols-3 gap-5">
    <div class="feature-card">
      <div class="brand-mark mb-4">✎</div>
      <h3 class="font-semibold mb-1.5">Post in seconds</h3>
      <p class="text-sm text-[var(--text-muted)]">Drop a thought, edit it anytime, and it's live on your profile instantly.</p>
    </div>
    <div class="feature-card">
      <div class="brand-mark mb-4">♥</div>
      <h3 class="font-semibold mb-1.5">Likes that count</h3>
      <p class="text-sm text-[var(--text-muted)]">A simple like system so you know what's actually landing.</p>
    </div>
    <div class="feature-card">
      <div class="brand-mark mb-4">🔒</div>
      <h3 class="font-semibold mb-1.5">Your account, secured</h3>
      <p class="text-sm text-[var(--text-muted)]">Passwords are hashed and sessions are token-based from day one.</p>
    </div>
  </section>

  <footer class="text-center text-xs text-[var(--text-faint)] pb-10">
    Built with Node.js, Express &amp; MongoDB
  </footer>

</body>
</html>
