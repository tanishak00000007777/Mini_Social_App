<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Profile' }) %>
</head>
<body class="bg-[var(--bg)] text-[var(--text)] min-h-screen">
  <%- include('partials/navbar') %>

  <div class="max-w-2xl mx-auto px-5 py-8">

    <!-- Profile header -->
    <div class="flex items-start gap-4 mb-8">
      <div class="avatar-wrap">
        <img class="avatar-img" src="<%= user.profilepic %>" alt="<%= user.name %>'s profile picture">
        <a href="/profile/upload" class="avatar-add" title="Change photo">+</a>
      </div>
      <div class="pt-1">
        <h3 class="text-2xl font-bold">
          Hello <span class="brand-gradient"><%= user.name %></span> 👋
        </h3>
        <p class="text-sm text-[var(--text-faint)]">@<%= user.username %></p>
      </div>
    </div>

    <!-- Create post -->
    <div class="card p-5 mb-10">
      <form action="/create" method="post" id="postForm">
        <textarea
          name="content"
          id="postContent"
          placeholder="What's on your mind?"
          required
          maxlength="500"
          class="field h-24 resize-none mb-2"
        ></textarea>
        <div class="flex items-center justify-between">
          <span class="char-counter"><span id="charCount">0</span>/500</span>
          <button type="submit" class="px-5 py-2 rounded-md text-sm font-semibold text-white" style="background:linear-gradient(135deg, var(--accent), #7c3aed);">
            Post
          </button>
        </div>
      </form>
    </div>

    <!-- Posts -->
    <div>
      <h3 class="text-sm font-semibold text-[var(--text-faint)] uppercase tracking-wide mb-4">Your Posts</h3>

      <% if (!user.posts || user.posts.length === 0) { %>
        <div class="empty-state">
          <div class="text-3xl mb-3">📝</div>
          <p class="font-medium text-[var(--text)] mb-1">No posts yet</p>
          <p class="text-sm">Share your first thought above — it'll show up here.</p>
        </div>
      <% } else { %>
        <div class="space-y-4">
          <% user.posts.slice().reverse().forEach(function(post) { %>
            <div class="post-card">
              <div class="flex items-center justify-between mb-2">
                <h4 class="text-[var(--accent)] font-semibold text-sm"><%= user.username %></h4>
                <span class="text-xs text-[var(--text-faint)]"><%= timeAgo(post.date) %></span>
              </div>
              <p class="text-[15px] text-[var(--text)] leading-relaxed whitespace-pre-wrap"><%= post.content %></p>
              <div class="flex items-center gap-5 mt-3">
                <a href="/like/<%= post._id %>" class="like-link <%= post.likes.indexOf(user._id) !== -1 ? 'liked' : '' %>">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="<%= post.likes.indexOf(user._id) !== -1 ? 'currentColor' : 'none' %>" stroke="currentColor" stroke-width="2"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
                  <%= post.likes.length %> <%= post.likes.indexOf(user._id) !== -1 ? "Liked" : "Like" %>
                </a>
                <a href="/edit/<%= post._id %>" class="edit-link">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/></svg>
                  Edit
                </a>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>

  </div>

  <%- include('partials/toast') %>
  <script src="/js/auth.js"></script>
  <script>
    const contentBox = document.getElementById('postContent');
    const charCount = document.getElementById('charCount');
    contentBox.addEventListener('input', () => {
      charCount.textContent = contentBox.value.length;
    });
  </script>
</body>
</html>
